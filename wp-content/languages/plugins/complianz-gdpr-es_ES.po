#: settings/config/fields/wizard/services.php:265
msgid "Amazon Consent Signal communicates user consent for ad storage and personal data processing to Amazon's advertising infrastructure."
msgstr "Amazon Consent Signal transmite a la infraestructura publicitaria de Amazon el consentimiento del usuario para el almacenamiento de anuncios y el tratamiento de datos personales."

#: settings/config/fields/wizard/services.php:264
msgid "Amazon Consent Signal"
msgstr "Amazon Consent Signal"

#: settings/config/fields/wizard/services.php:261
msgid "Required if you use Amazon Advertising products (e.g. Amazon DSP) and are not using TCF. ACS sends consent status to Amazon for visitors in the UK and EEA."
msgstr "Obligatorio si usas productos de Amazon Advertising (p. ej., Amazon DSP) y no usas TCF. ACS envía el estado de consentimiento a Amazon para los visitantes del Reino Unido y del EEE."

#: settings/config/fields/wizard/services.php:260
msgid "Do you want to enable Amazon Consent Signal (ACS)?"
msgstr "¿Quieres activar Amazon Consent Signal (ACS)?"

