#: websitescan/class-wsc-scanner.php:1203
msgid "Are you no longer the website administrator? <a href=\"%1$s\" target=\"_blank\">Click here</a> to dismiss notifications."
msgstr "¿Ya no administras la web? <a href=\"%1$s\" target=\"_blank\">Haz clic aquí</a> para descartar los avisos."

#: websitescan/class-wsc-scanner.php:1194
